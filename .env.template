# 将本文件复制为 `.env`，并填写需要使用的模型密钥。

# 默认聊天模型。MODEL_NAME 既可以只写模型 ID，也可以写“提供方/模型”。
MODEL_PROVIDER=qwen
MODEL_NAME=

# 可选备用模型，多个模型使用英文逗号分隔。
# 使用备用模型时，也必须配置对应提供方的 API Key。
MODEL_FALLBACKS=deepseek/deepseek-v4-flash

# RAG 使用的向量模型与聊天模型独立配置。
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_FALLBACKS=

# 通用调用参数。
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=8192
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# OpenRouter，可选
OPENROUTER_API_KEY=
# 用于 OpenRouter 使用策略和分析的可选请求头
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
# 可选服务地址；留空时使用默认值
OPENROUTER_API_BASE=

# OpenAI，可选
OPENAI_API_KEY=
OPENAI_API_BASE=

# Anthropic，可选
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=

# Google Gemini，可选
GOOGLE_API_KEY=

# 阿里云百炼／通义千问
DASHSCOPE_API_KEY=
# 下方是北京地域共享地址；生产环境建议替换为业务空间专属地址。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
